# Porta HTTP exposta pelo container/servidor
PORT=3000

# URL pública acessível pelos celulares na mesma rede (usada no QR Code e no OAuth do Spotify).
# Ex.: http://192.168.0.10:3000 — se vazio, o frontend usa a URL atual do navegador.
PUBLIC_URL=

# Nome mDNS (.local) anunciado na rede local (ex.: jkbox -> http://jkbox.local:3000).
# No Docker Linux, requer network_mode: host para o multicast mDNS alcançar a rede.
MDNS_HOSTNAME=jkbox
MDNS_ENABLED=true

# Diretório de dados persistentes (músicas + banco SQLite). Padrão local: ./data
# No Docker é sempre /data (montado a partir de ./data pelo docker-compose).
# DATA_DIR=./data

# Formato de áudio padronizado para downloads (m4a | mp3 | opus)
AUDIO_FORMAT=m4a

# Downloads simultâneos em segundo plano
DOWNLOAD_CONCURRENCY=2

# Modo de videoclipe no Kiosk: cache (baixa MP4 local sem anúncios), embed (iframe YouTube) ou off (apenas áudio/capa)
VIDEO_MODE=cache

# Altura máxima em pixels dos vídeos em cache (padrão 720p em MP4 para manter arquivos leves)
VIDEO_MAX_HEIGHT=720

# PIN opcional para ações do host (pular, pausar, remover músicas de outros).
# Vazio = qualquer dispositivo pode executar ações do host.
HOST_PIN=

# Atualiza o yt-dlp ao iniciar o container (o YouTube muda com frequência)
YTDLP_AUTO_UPDATE=true

# Argumentos extras repassados ao yt-dlp (ex.: --cookies /data/cookies.txt)
YTDLP_EXTRA_ARGS=

# --- Spotify (opcional) ---------------------------------------------------
# Sem estas credenciais o app funciona normalmente com YouTube + Acervo Local.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Deve estar cadastrada no app do Spotify Developer Dashboard.
# Padrão: ${PUBLIC_URL}/api/spotify/callback (o Spotify exige 127.0.0.1 em vez de localhost)
SPOTIFY_REDIRECT_URI=
SPOTIFY_PLAYLIST_NAME=jkbox-studio
# Intervalo (segundos) para importar faixas adicionadas na playlist pelo app do Spotify. 0 = desativado
SPOTIFY_IMPORT_INTERVAL=60
